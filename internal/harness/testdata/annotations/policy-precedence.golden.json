  "schema_version": 1,
  "description": "Cross-repository policy precedence contract. Each case defines UUID-keyed groups (children reference ids), users, policies, requests and expected outcomes. Invalid group graphs fail with expected_error. Request expected_outranked entries include every matching loser and its reason. effective_by_group includes inherited/global/harness policies with displayed origins in precedence order. Annotation cases include requests for claude_code, codex and opencode; this field is additive and schema_version remains 1.",
  "cases": [
    {
      "name": "realistic group ids, descendants, and a two-parent diamond",
      "groups": [
        {"id":"00000000-0000-4000-8000-000000000001","name":"members","children":[]},
        {"id":"00000000-0000-4000-8000-000000000002","name":"developers","children":["00000000-0000-4000-8000-000000000001"]},
        {"id":"00000000-0000-4000-8000-000000000003","name":"admins","children":["00000000-0000-4000-8000-000000000001"]},
        {"id":"00000000-0000-4000-8000-000000000004","name":"security","children":["00000000-0000-4000-8000-000000000002","00000000-0000-4000-8000-000000000003"]}
      ],
      "users": [
        {"email":"dev@example.com","groups":["00000000-0000-4000-8000-000000000002"]},
        {"email":"security@example.com","groups":["00000000-0000-4000-8000-000000000004"]},
        {"email":"ada@example.com","groups":["00000000-0000-4000-8000-000000000002"]}
      ],
      "policies": [
        {"id":"p-git","name":"Git commands","src_pattern":"group:developers","dst_pattern":"shell:git","action":"permit","priority":10,"enabled":true},
        {"id":"p-disabled","name":"Disabled Git block","src_pattern":"group:developers","dst_pattern":"shell:git","action":"deny","priority":100,"enabled":false},
        {"id":"p-rm","name":"Temporary directory removal","src_pattern":"group:admins","dst_pattern":"shell:rm -rf /tmp/","action":"deny","priority":20,"enabled":true},
        {"id":"p-path","name":"Source tree","src_pattern":"group:security","dst_pattern":"path:/workspace/src/","action":"deny","priority":30,"enabled":true},
        {"id":"p-skill","name":"Deploy skill","src_pattern":"group:members","dst_pattern":"skill:deploy","action":"permit","priority":15,"enabled":true},
        {"id":"p-connector","name":"Repository deletion","src_pattern":"group:admins","dst_pattern":"connector:github.repos.*","action":"deny","priority":25,"enabled":true},
        {"id":"p-user","name":"Ada only","src_pattern":"user:ada@example.com","dst_pattern":"path:/private/","action":"deny","priority":40,"enabled":true},
        {"id":"p-any-harness","name":"Any harness npm","src_pattern":"harness:*","dst_pattern":"shell:npm run","action":"permit","priority":5,"enabled":true},
        {"id":"p-codex","name":"Codex npm block","src_pattern":"harness:codex","dst_pattern":"shell:npm run","action":"deny","priority":5,"enabled":true},
        {"id":"p-tie-permit","name":"Tie permit","src_pattern":"group:developers","dst_pattern":"path:/tie/","action":"permit","priority":50,"enabled":true},
        {"id":"p-tie-deny","name":"Tie deny","src_pattern":"group:developers","dst_pattern":"path:/tie/","action":"deny","priority":50,"enabled":true},
        {"id":"id-a","name":"Lower id permit","src_pattern":"group:developers","dst_pattern":"path:/id-tie/","action":"permit","priority":7,"enabled":true},
        {"id":"id-z","name":"Higher id permit","src_pattern":"group:developers","dst_pattern":"path:/id-tie/","action":"permit","priority":7,"enabled":true}
      ],
      "requests": [
        {"name":"whole-token shell prefix matches","user":"dev@example.com","harness":"codex","resource":"shell:git push origin","expected_winner":"p-git","expected_outranked":[{"policy_id":"p-disabled","reason":"disabled"}]},
        {"name":"shell prefix does not match a longer token","user":"dev@example.com","harness":"codex","resource":"shell:gitx push","expected_winner":null,"expected_outranked":[]},
        {"name":"slash-ended last token matches by string prefix","user":"security@example.com","harness":"codex","resource":"shell:rm -rf /tmp/x","expected_winner":"p-rm","expected_outranked":[]},
        {"name":"slash-ended token does not match a different prefix","user":"security@example.com","harness":"codex","resource":"shell:rm -rf /tmpx/x","expected_winner":null,"expected_outranked":[]},
        {"name":"path prefix matches descendants","user":"security@example.com","harness":"codex","resource":"path:/workspace/src/main.ts","expected_winner":"p-path","expected_outranked":[]},
        {"name":"skill matching is exact","user":"dev@example.com","harness":"codex","resource":"skill:deploy","expected_winner":"p-skill","expected_outranked":[]},
        {"name":"skill near miss does not match","user":"dev@example.com","harness":"codex","resource":"skill:deploy-prod","expected_winner":null,"expected_outranked":[]},
        {"name":"connector star matches delete operation","user":"security@example.com","harness":"codex","resource":"connector:github.repos.delete","expected_winner":"p-connector","expected_outranked":[]},
        {"name":"user email principal applies","user":"ada@example.com","harness":"opencode","resource":"path:/private/key","expected_winner":"p-user","expected_outranked":[]},
        {"name":"wildcard harness applies to a different harness kind","user":"dev@example.com","harness":"opencode","resource":"shell:npm run build","expected_winner":"p-any-harness","expected_outranked":[]},
        {"name":"specific harness policy applies only to its kind and deny wins a tie","user":"dev@example.com","harness":"codex","resource":"shell:npm run build","expected_winner":"p-codex","expected_outranked":[{"policy_id":"p-any-harness","reason":"tied_deny_beats_permit"}]},
        {"name":"equal priority deny beats permit","user":"dev@example.com","harness":"codex","resource":"path:/tie/item","expected_winner":"p-tie-deny","expected_outranked":[{"policy_id":"p-tie-permit","reason":"tied_deny_beats_permit"}]},
        {"name":"equal priority same effect uses ascending policy id","user":"dev@example.com","harness":"codex","resource":"path:/id-tie/item","expected_winner":"id-a","expected_outranked":[{"policy_id":"id-z","reason":"tied_lower_id"}]},
        {"name":"two-parent diamond closure is deduplicated","user":"security@example.com","harness":"codex","resource":"skill:deploy","expected_winner":"p-skill","expected_outranked":[]},
        {"name":"no match leaves the harness default","user":"dev@example.com","harness":"codex","resource":"connector:github.issues.read","expected_winner":null,"expected_outranked":[]}
