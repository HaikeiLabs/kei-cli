{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "my-local": {"type": "local", "command": ["npx", "-y", "@me/server"]},
    "github": {"type": "remote", "url": "https://api.githubcopilot.com/mcp/"},
    "linear": {
      "type": "remote",
      "url": "http://127.0.0.1:8086/mcp/linear",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:KEI_MCP_ROUTE_KEY}"
      }
    },
    "notion": {
      "type": "remote",
      "url": "http://127.0.0.1:8086/mcp/notion",
      "enabled": true,
      "headers": {
        "Authorization": "Bearer {env:KEI_MCP_ROUTE_KEY}"
      }
    }
  },
  "permission": {"bash": {"git status": "allow"}}
}
