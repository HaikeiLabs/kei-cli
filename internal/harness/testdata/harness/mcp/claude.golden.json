{
  "numStartups": 12,
  "mcpServers": {
    "my-local": {"command": "npx", "args": ["-y", "@me/server"]},
    "github": {"type": "http", "url": "https://api.githubcopilot.com/mcp/"},
    "linear": {
      "type": "http",
      "url": "https://mcp.linear.example/mcp",
      "headers": {
        "Authorization": "Bearer ${KEI_MCP_LINEAR_TOKEN}"
      }
    },
    "notion": {
      "type": "http",
      "url": "https://mcp.notion.example/mcp",
      "headers": {
        "Authorization": "Bearer ${KEI_MCP_NOTION_TOKEN}"
      }
    }
  },
  "projects": {
    "/work/app": {"allowedTools": []}
  }
}
