{
  "model": "claude-sonnet-4-5",
  "env": {
    "GREETING": "a \u0026 b \u003c c",
    "NAME": "caf\u00e9"
  },
  "permissions": {
    "allow": [
      "Bash(user:*)",
      "Bash(git:*)"
    ],
    "deny": [
      "Bash(rm:*)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "kei-proxy hook claude",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "kei-proxy hook claude",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ]
  }
}
